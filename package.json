{
  "name": "@corbits/embedding",
  "description": "Embedding client for OpenAI-compatible /v1/embeddings endpoints, built on the Interchange inference primitives",
  "version": "0.2.0",
  "license": "LGPL-2.1-only",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "bun test ./src",
    "test:e2e": "bun test ./e2e",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "arktype": "^2.2.3"
  },
  "peerDependencies": {
    "@intx/inference": "^0.4.0",
    "@intx/types": "^0.4.0"
  },
  "devDependencies": {
    "@intx/inference": "0.4.0",
    "@intx/inference-testing": "0.4.0",
    "@intx/types": "0.4.0",
    "@types/bun": "1.3.9",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "5.9.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/corbits-embedding.git"
  },
  "homepage": "https://github.com/corbitsdev/corbits-embedding",
  "bugs": {
    "url": "https://github.com/corbitsdev/corbits-embedding/issues"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=24"
  }
}
